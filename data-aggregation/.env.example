# fuel-lake — example environment (copy to .env; never commit .env)
# Licensed under Apache-2.0.
# Load with: uv run --env-file .env fuellake ...

# Lake root: local directory or s3://bucket/prefix. Leave unset for the default <repo>/../fuel-lake-data
# (a relative path here would resolve against the current directory, not the repo).
# LAKE_ROOT=/absolute/path/to/fuel-lake-data
# FUELLAKE_CONFIG_DIR=./config
# FUELLAKE_CACHE_DIR=~/.cache/fuel-lake     # download cache outside the lake (Globe-LFMC workbook, FIRMS CSVs)

# MinIO / S3-compatible roots (credentials are read by botocore, never by fuel-lake)
# FUELLAKE_S3_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Consumers (LakeClient.from_env): read through the HTTP API instead of LAKE_ROOT
# FUELLAKE_API_URL=http://127.0.0.1:8000

# Source credentials (only needed by the connectors that use them; `fuellake run all` skips what needs
# a missing one, a dataset named explicitly fails loudly)
# NISAR SME2 / GCOV and OPERA RTC-S1 file downloads (CMR search is public)
EARTHDATA_TOKEN=
# FIRMS area API: the current year (past years come from the keyless yearly archive)
FIRMS_MAP_KEY=
# ERA5-Land via the Copernicus CDS API (URL e.g. https://cds.climate.copernicus.eu/api)
CDSAPI_URL=
CDSAPI_KEY=
